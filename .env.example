# Reference ports for running services locally with Uvicorn.
# Docker Compose uses port 8000 internally and publishes only the gateway.
MOBILITY_PORT=8001
FOOD_PORT=8002
MEAL_PLANNING_PORT=8003
USER_PORT=8004
GATEWAY_PORT=8080

# Local HTTP dependencies for Meal Planning Service.
MOBILITY_SERVICE_URL=http://127.0.0.1:8001
FOOD_SERVICE_URL=http://127.0.0.1:8002
SERVICE_TIMEOUT_SECONDS=3
